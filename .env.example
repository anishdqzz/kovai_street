# Optional for local development; without it, accounts are saved in .data/users.json.
# Set this to a MongoDB Atlas or local MongoDB connection string to use MongoDB.
MONGODB_URI=mongodb+srv://anish:cEhuOlzRElZEHGAM@development-kit.5vd29z7.mongodb.net/?appName=development-kit
# Set NODE_ENV=production and provide real MongoDB and JWT settings when deploying.
NODE_ENV=development
# Leave empty to automatically find an available port (starting at 4173).
PORT=
# Locally, a development-only default is provided. Use a unique random value for deployment.
JWT_SECRET=
# Leave empty for local development. Set this to your deployed URL in production.
APP_ORIGIN=

# SMTP is required for password reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kovai Streets <noreply@example.com>"
