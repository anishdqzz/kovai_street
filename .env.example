# Optional for local development; without it, accounts are saved in .data/users.json.
# Replace every placeholder with your own private MongoDB Atlas connection details.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
NODE_ENV=development
# Leave empty to automatically find an available port (starting at 4173).
PORT=
# Locally, a development-only default is provided. Use a unique random value for deployment.
JWT_SECRET=
# Leave empty for local development. Set to your deployed URL in production if not supplied by the host.
APP_ORIGIN=

# Optional WebRTC relay for mobile/restricted networks. Use short-lived TURN credentials.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# SMTP is required for password reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kovai Streets <noreply@example.com>"
